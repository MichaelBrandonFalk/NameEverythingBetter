{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Name Everything Better V2_0",
  "version": "2.0.0",
  "identifier": "com.nameeverythingbetter.desktop",
  "build": { "beforeBuildCommand": "npm run prepare-site", "frontendDist": "../site" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "Name Everything Better", "width": 1200, "height": 860, "minWidth": 390, "minHeight": 600}],
    "security": { "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility", "shortDescription": "Movies, captions and art naming with saved convention profiles",
    "linux": {"deb": {"depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]}},
    "windows": {"webviewInstallMode": {"type": "downloadBootstrapper"}}
  }
}
